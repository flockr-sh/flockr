# Maintainer: Dylan Kenney <dylanmkenney@gmail.com>
pkgname=flockr-bin
pkgver=1.2.0
pkgrel=1
pkgdesc="Terminal workspace manager for AI coding agents (release binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/flockr-sh/flockr"
license=('Apache-2.0')
provides=('flockr')
conflicts=('flockr')
options=('!strip' '!debug')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/flockr-sh/flockr/v$pkgver/LICENSE")
source_x86_64=("flockr-$pkgver-x86_64::$url/releases/download/v$pkgver/flockr-linux-x86_64")
source_aarch64=("flockr-$pkgver-aarch64::$url/releases/download/v$pkgver/flockr-linux-aarch64")
sha256sums=('c71d239df91726fc519c6eb72d318ec65820627232b2f796219e87dcf35d0ab4')
sha256sums_x86_64=('9ee6cfcb272b4e2bea7bbe649f447de9cdc1040ddc910e0da9568f399973f240')
sha256sums_aarch64=('a44c2409bb0a80b7736b2099c56481216a58163682c2d33f3fd4880106187caa')

package() {
  local bin="flockr-$pkgver-$CARCH"
  install -Dm755 "$bin" "$pkgdir/usr/bin/flockr"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  chmod +x "$bin"
  "./$bin" completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/flockr"
  "./$bin" completion zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_flockr"
  "./$bin" completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/flockr.fish"
}
